[user]
	email = tiago@tiago.sh
	name = Tiago Oliveira
	signingkey = ~/.ssh/id_ed25519.pub
[color]
	ui = auto
[core]
	excludesfile = ~/.gitignore_global
  pager = hunk pager
[push]
	default = simple
  autoSetupRemote = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Machine-local overrides (not in this repo, git ignores the include if the file is
# missing). Keep this LAST: later settings win, so it can override [user] above.
[include]
	path = ~/.gitconfig-extended
